<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".LoginActivity">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:layout_marginTop="40dp"
            android:layout_marginStart="30dp"/>

        <TextView
            android:id="@+id/tv_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="login"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toStartOf="@id/btn_back"
            android:layout_marginTop="30dp"
            android:textColor="@color/white_87"/>
        <TextView
            android:id="@+id/tv_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/tv_login"
            app:layout_constraintTop_toBottomOf="@id/tv_login"
            android:layout_marginTop="40dp"
            android:textColor="@color/white_87"
            />
        <EditText
            android:id="@+id/edt_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tv_title1"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/custom_edit"
            android:hint="Enter your username"
            android:textSize="16sp"
            android:paddingVertical="15dp"
            android:paddingStart="10dp"
            android:textColorHint="@color/white_44"
            android:textColor="@color/white_87"/>
        <TextView
            android:id="@+id/tv_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/edt_username"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="@id/edt_username"
            android:textColor="@color/white_87"
            />
        <EditText
            android:id="@+id/edt_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tv_title2"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/custom_edit"
            android:hint="............"
            android:textSize="16sp"
            android:paddingStart="10dp"
            android:paddingVertical="15dp"
            android:textColorHint="@color/white_44"
            android:textColor="@color/white_87"
            android:inputType="textPassword"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@id/login_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/edt_password"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="50dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="15dp"
            android:background="@drawable/custom_btn_login"
            android:textColor="@color/white_87"/>
        <TextView
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/login_button"
            android:background="@color/white_44"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="30dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or"
           app:layout_constraintTop_toBottomOf="@id/login_button"
            android:layout_marginTop="27dp"
            app:layout_constraintStart_toStartOf="@id/line"
            app:layout_constraintEnd_toEndOf="@id/line"
            android:textSize="16sp"
            android:background="@color/black"
            android:paddingEnd="2dp"
            android:paddingStart="1dp"
            android:textColor="@color/white_44"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/login_with_gg_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/line"
            android:layout_marginTop="30dp"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/custom_button_create_account"
            android:text="Login With Google"
            android:textSize="16sp"
            android:textColor="@color/white_87"
            android:textAllCaps="false"
            android:drawableStart="@drawable/logo_google"
            android:drawablePadding="0dp"
            android:paddingStart="80dp"
            android:paddingEnd="80dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/login_with_fb_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/login_with_gg_button"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/custom_button_create_account"
            android:text="Login With Facebook"
            android:textColor="@color/white_87"
            android:drawableStart="@drawable/logo_facebook"
            android:paddingStart="80dp"
            android:paddingEnd="60dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            />
        <TextView
            android:id="@+id/tv_title3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/login_with_fb_button"
            android:text="Don't have an account?"
            app:layout_constraintStart_toStartOf="@id/login_with_fb_button"
            android:layout_marginTop="30dp"
            android:textSize="12sp"
            android:textColor="@color/white_44"
            app:layout_constraintEnd_toEndOf="@id/login_with_fb_button"
            android:layout_marginEnd="65dp"/>
        <TextView
            android:id="@+id/register_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_title3"
            android:text="Register"
            app:layout_constraintStart_toEndOf="@id/tv_title3"
            android:textColor="@color/white_44"
            android:textStyle="bold"
            android:layout_marginStart="2dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>