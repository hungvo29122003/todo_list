<?xml version="1.0" encoding="utf-8"?>
<layout>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        tools:context=".RegisterActivity">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:layout_marginTop="30dp"
            android:layout_marginStart="30dp"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/back_button"
            app:layout_constraintStart_toStartOf="@id/back_button"
            android:layout_marginTop="20dp"
            android:text="Register"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white_87"/>
        <TextView
            android:id="@+id/tv_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            android:text="Email"
            app:layout_constraintStart_toStartOf="@id/tv_title"
            android:layout_marginTop="30dp"
            android:textSize="16sp"
            android:textColor="@color/white_87"/>
        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tv_title1"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/custom_edit"
            android:hint="Enter your email"
            android:textSize="16sp"
            android:paddingVertical="15dp"
            android:paddingStart="10dp"
            android:textColorHint="@color/white_44"
            android:textColor="@color/white_87"/>
        <TextView
            android:id="@+id/tv_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/edit_email"
            app:layout_constraintStart_toStartOf="@id/edit_email"
            android:layout_marginTop="30dp"
            android:text="Password"
            android:textSize="16sp"
            android:textColor="@color/white_87"/>
        <EditText
            android:id="@+id/edi_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_edit"
            android:hint="............"
            android:textSize="16sp"
            android:paddingStart="10dp"
            android:paddingVertical="15dp"
            android:inputType="textPassword"
            app:layout_constraintTop_toBottomOf="@id/tv_title2"
            android:layout_marginHorizontal="30dp"
            android:textColorHint="@color/white_44"
            android:textColor="@color/white_87"
            android:layout_marginTop="10dp"/>
        <TextView
            android:id="@+id/tv_title3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/edi_password"
            android:text="Confirm Password"
            app:layout_constraintStart_toStartOf="@id/edi_password"
            android:layout_marginTop="30dp"
            android:textSize="16sp"
            android:textColor="@color/white_87"/>
        <EditText
            android:id="@+id/edit_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title3"
            android:background="@drawable/custom_edit"
            android:hint="............"
            android:textSize="16sp"
            android:paddingStart="10dp"
            android:paddingVertical="15dp"
            android:textColorHint="@color/white_44"
            android:textColor="@color/white_87"
            android:inputType="textPassword"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/register_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/edit_confirm_password"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="50dp"
            android:text="Register"
            android:background="@drawable/custom_btn_login"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/white_44"
            android:paddingVertical="15dp"/>
        <TextView
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/register_button"
            android:background="@color/white_44"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="30dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or"
            app:layout_constraintTop_toBottomOf="@id/register_button"
            android:layout_marginTop="27dp"
            app:layout_constraintStart_toStartOf="@id/line"
            app:layout_constraintEnd_toEndOf="@id/line"
            android:textSize="16sp"
            android:background="@color/black"
            android:paddingEnd="2dp"
            android:paddingStart="1dp"
            android:textColor="@color/white_44"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/register_with_gg_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/line"
            android:layout_marginTop="30dp"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/custom_button_create_account"
            android:text="Register With Google"
            android:textSize="16sp"
            android:textColor="@color/white_87"
            android:textAllCaps="false"
            android:drawableStart="@drawable/logo_google"
            android:drawablePadding="0dp"
            android:paddingStart="80dp"
            android:paddingEnd="80dp"/>
        <TextView
            android:id="@+id/tv_title4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/register_with_gg_button"
            android:text="Already have an account?"
            app:layout_constraintStart_toStartOf="@id/register_with_gg_button"
            android:layout_marginTop="30dp"
            android:textSize="12sp"
            android:textColor="@color/white_44"
            app:layout_constraintEnd_toEndOf="@id/register_with_gg_button"
            android:layout_marginEnd="65dp"/>
        <TextView
            android:id="@+id/login_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_title4"
            android:text="Login"
            app:layout_constraintStart_toEndOf="@id/tv_title4"
            android:textColor="@color/white_44"
            android:textStyle="bold"
            android:layout_marginStart="2dp"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>